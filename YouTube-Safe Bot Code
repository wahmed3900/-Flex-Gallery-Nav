    "You're asking the right question. DM me — I'll show you exactly how I started with $0.",
]

# Simulated comment fetcher (replace with YouTube API)
class SafeYouTubeReader:
    def get_comment_queue(self, video_id: str) -> List[Dict]:
        # In real implementation: fetch recent comments, avoid ones you already replied to
        return [
            {"author": "curious_mike", "text": "can I really do this with just my phone?", "time": "recent"},
            {"author": "jenny_saves", "text": "no experience? seriously how?", "time": "recent"},
            {"author": "busy_dad", "text": "I need a side hustle but I'm clueless", "time": "recent"},
        ]

# Simple intent check — won't reply to negative or irrelevant comments
def is_genuine_question(comment_text: str) -> bool:
    positive_signals = ["how", "start", "phone", "side hustle", "experience", "work", "money", "curious", "really"]
    negative_signals = ["scam", "fake", "hate", "stupid", "bullshit", "lies"]
    
    text_lower = comment_text.lower()
    if any(sig in text_lower for sig in negative_signals):
        return False
    return any(sig in text_lower for sig in positive_signals)

# Pick a random friendly reply
def get_friendly_reply(username: str) -> str:
    template = random.choice(FRIENDLY_REPLIES)
    # Some templates already have @, some don't
    if "@" not in template and username:
        return f"@{username} {template}"
    return template

# The main safe bot
class YouTubeFriendlyBot:
    def __init__(self):
        self.reply_count_today = 0
        self.replied_users = set()
        self.replied_comments = set()
    
    def can_reply(self) -> bool:
        return self.reply_count_today < MAX_REPLIES_PER_DAY
    
    def post_reply_safely(self, comment: Dict, reply_text: str):
        """
        Replace this with actual YouTube API call:
        - Use youtube.commentThreads().insert()
        - Add random delay BEFORE calling this
        """
        print(f"💬 Replying to @{comment['author']}:")
        print(f"   → {reply_text}\n")
        # In production: YouTube API comment insert here
        self.reply_count_today += 1
    
    def run_once(self, video_id: str):
        if not self.can_reply():
            print("⚠️ Daily reply limit reached. Stopping.")
            return
        
        comments = SafeYouTubeReader().get_comment_queue(video_id)
        replies_made = 0
        
        for comment in comments:
            if not self.can_reply():
                break
            if replies_made >= MAX_REPLIES_PER_VIDEO:
                break
            
            author = comment["author"]
            comment_id = comment.get("id", comment["text"][:20])
            
            if author in self.replied_users or comment_id in self.replied_comments:
                continue
            
            if is_genuine_question(comment["text"]):
                reply = get_friendly_reply(author)
                self.post_reply_safely(comment, reply)
                self.replied_users.add(author)
                self.replied_comments.add(comment_id)
                replies_made += 1
                
                # Human-like delay between replies
                delay_seconds = random.randint(MIN_DELAY_MINUTES * 60, MAX_DELAY_MINUTES * 60)
                print(f"⏳ Waiting {delay_seconds//60} minutes before next reply...\n")
                time.sleep(delay_seconds)
        
        print(f"✅ Done. Made {replies_made} replies today.")

