MIN_DELAY_MINUTES = 5      # Min wait between replies
MAX_DELAY_MINUTES = 15     # Max wait between replies
MAX_REPLIES_PER_DAY = 12   # Hard cap to avoid detection
MAX_REPLIES_PER_VIDEO = 8  # Per video limit

# ========== FRIENDLY REPLY TEMPLATES ==========
# All keep the DM CTA intact, but vary wording naturally
FRIENDLY_REPLIES = [
    "Great question! 🙌 I started the same way — just my phone. Happy to share what worked. Send me a DM?",
    "Thanks for asking! ✨ No experience needed at all. Want me to show you how I started? DM me :)",
    "Honestly? I was skeptical too. But it's working with just my phone. DM me if you want the breakdown.",
    "You can definitely do this! Zero fluff, I promise. Curious? Shoot me a DM and I'll explain.",
    "Love the curiosity! Took me 3 days to get started. DM me and I'll send you the first step.",
    "Appreciate you asking! Most people overcomplicate it. DM me — I'll keep it simple.",
