import time
import random
import os
from openai import OpenAI

# ========== CONFIGURATION ==========
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
client = OpenAI(api_key=OPENAI_API_KEY)

# Safety limits
MIN_DELAY_MINUTES = 5
MAX_DELAY_MINUTES = 15
MAX_REPLIES_PER_DAY = 12
SKIP_CHANCE = 0.20  # 20% chance to skip a qualifying comment (looks human)

# Your DM CTA (will be naturally integrated by GPT-4)
DM_CTA = "Send me a DM if you want me to show you how I started"

# ========== GPT-4 REPLY GENERATOR ==========
def generate_friendly_reply(comment_text: str, author: str) -> str:
    """Generate a unique, human reply using GPT-4"""
    
    prompt = f"""
You are a helpful, friendly YouTuber/creator replying to a comment.

COMMENT from @{author}: "{comment_text}"

RULES:
- Be warm, encouraging, and conversational
- Keep it under 120 characters (mobile-friendly)
- NO links, NO hashtags, NO all-caps
- Naturally include this CTA (but rephrase it slightly each time):
  "{DM_CTA}"
- Use occasional emojis (1-2 max) like 🙌 ✨ 👍
- Sound like a real person, not a bot
- Never be salesy or pushy

Reply directly to @{author}:
"""
    
    response = client.chat.completions.create(
        model="gpt-4o-mini",  # cheaper, fast, good enough
        messages=[{"role": "user", "content": prompt}],
        max_tokens=60,
        temperature=0.9  # higher creativity = less repetitive
    )
    
    reply = response.choices[0].message.content.strip()
    
    # Ensure CTA is present (fallback)
    if "DM" not in reply and "dm" not in reply:
        reply += f" {DM_CTA}"
    
    return reply

# ========== PLATFORM-SAFE CHECKERS ==========
def is_safe_to_reply(comment_text: str) -> bool:
    """Filter out negative/spammy comments"""
    unsafe = ["scam", "fake", "hate", "stupid", "bullshit", "report", "block", "spam"]
    text_lower = comment_text.lower()
    
    if any(word in text_lower for word in unsafe):
        return False
    
    # Skip random chance
    if random.random() < SKIP_CHANCE:
        return False
    
    return True

def is_genuine_question(comment_text: str) -> bool:
    """Only reply to real engagement"""
    signals = ["how", "start", "phone", "side hustle", "experience", "work", "money", "curious", "really", "help", "advice", "tips", "please", "question"]
    text_lower = comment_text.lower()
    return any(sig in text_lower for sig in signals)

