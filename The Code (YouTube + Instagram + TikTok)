# ========== MAIN BOT ENGINE ==========
class UniversalFriendlyBot:
    def __init__(self, platform: str, content_id: str):
        self.platform = platform
        self.content_id = content_id
        self.reply_count = 0
        self.replied_comment_ids = set()
        
        # Select platform adapter
        if platform == "youtube":
            self.adapter = YouTubeAdapter()
        elif platform == "instagram":
            self.adapter = InstagramAdapter()
        elif platform == "tiktok":
            self.adapter = TikTokAdapter()
        else:
            raise ValueError("Platform must be youtube, instagram, or tiktok")
    
    def can_reply(self) -> bool:
        return self.reply_count < MAX_REPLIES_PER_DAY
    
    def run_once(self):
        print(f"\n🚀 Starting {self.platform.upper()} bot — Safe Mode ON")
        print(f"📊 Daily limit: {MAX_REPLIES_PER_DAY} replies")
        
        # Fetch comments (implement based on platform)
        comments = self.adapter.get_new_comments(self.content_id)
        
        for comment in comments[:MAX_REPLIES_PER_DAY * 2]:  # Fetch extra to filter
            if not self.can_reply():
                print("Daily limit reached. Stopping.")
                break
            
            comment_id = comment["id"]
            comment_text = comment["text"]
            author = comment["author"]
            
            # Skip if already replied
            if comment_id in self.replied_comment_ids:
                continue
            
            # Safety filters
            if not is_safe_to_reply(comment_text):
                print(f"⏭️ Skipped unsafe comment from @{author}")
                continue
            
            if not is_genuine_question(comment_text):
                print(f"⏭️ Skipped non-question from @{author}")
                continue
            
            # Generate GPT-4 reply
            reply = generate_friendly_reply(comment_text, author)
            
            # Post the reply
            self.adapter.post_reply(comment_id, reply)
            self.replied_comment_ids.add(comment_id)
            self.reply_count += 1
            
            print(f"✅ Replied to @{author} (reply #{self.reply_count}): {reply}")
            
            # Human-like delay
            if self.can_reply():
                delay = random.randint(MIN_DELAY_MINUTES * 60, MAX_DELAY_MINUTES * 60)
                print(f"⏳ Sleeping {delay//60} minutes...")
                time.sleep(delay)
        
        print(f"\n🏁 Done. Made {self.reply_count} replies on {self.platform}.")

