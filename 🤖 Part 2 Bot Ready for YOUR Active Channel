# ========== YOUR SETUP ==========
OPENAI_API_KEY = "your_openai_api_key_here"
client = OpenAI(api_key=OPENAI_API_KEY)

# Your channel info
PLATFORM = "instagram"  # or "youtube"
CONTENT_ID = "your_video_id_or_post_url"

# Your DM CTA (keep this consistent)
DM_CTA = "Send me a DM and I'll show you exactly how I started"

# Safety
MAX_REPLIES_THIS_RUN = 8
DELAY_BETWEEN_REPLIES = (60, 180)  # 1-3 minutes in seconds

# ========== FAKE COMMENTS FOR TESTING ==========
# Replace this with real comments from your post
test_comments = [
    {"id": "1", "author": "hustler_sam", "text": "how do I actually start?"},
    {"id": "2", "author": "momof3", "text": "do I need any money to begin?"},
    {"id": "3", "author": "college_kid", "text": "is this really possible from phone?"},
]

# ========== GPT-4 REPLY GENERATOR ==========
def generate_reply(comment_text, author):
    prompt = f"""
You're a helpful creator replying to @{author}'s comment: "{comment_text}"

Rules:
- Short (under 100 characters)
- Warm and encouraging
- Include this naturally: "{DM_CTA}"
- 1 emoji max

Reply:
"""
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=60,
        temperature=0.9
    )
    reply = response.choices[0].message.content.strip()
    if "DM" not in reply:
        reply += f" {DM_CTA}"
    return reply

# ========== MAIN BOT ==========
def run_bot():
    print(f"\n🚀 Replying to comments on {PLATFORM}")
    print(f"📊 Will reply to max {MAX_REPLIES_THIS_RUN} comments\n")
    
    replies_made = 0
    # In production: fetch real comments via API
    # For now, using test_comments
    
    for comment in test_comments[:MAX_REPLIES_THIS_RUN]:
        author = comment['author']
        text = comment['text']
        
        print(f"💬 Found comment from @{author}: {text}")
        
        # Generate reply
        reply = generate_reply(text, author)
        
        # Show what would be posted
        print(f"   ✅ Would reply: {reply}")
        print(f"   ⏳ Waiting {DELAY_BETWEEN_REPLIES[0]}-{DELAY_BETWEEN_REPLIES[1]} seconds...\n")
        
        replies_made += 1
        time.sleep(random.randint(*DELAY_BETWEEN_REPLIES))
        
        # Stop if hit limit
        if replies_made >= MAX_REPLIES_THIS_RUN:
            break
    
    print(f"\n🏁 Done! Would have replied to {replies_made} comments.")
    print("👉 Replace 'test_comments' with real API data to actually post.")

